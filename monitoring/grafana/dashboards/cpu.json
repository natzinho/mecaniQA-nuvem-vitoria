{
  "id": null,
  "uid": "mecaniqa-cpu",
  "title": "CPU",
  "description": "CPU do processo Python no Linux; 100% equivale a um núcleo. Não mede CPU total do nó/cluster.",
  "tags": [
    "mecaniqa",
    "continuidade"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
