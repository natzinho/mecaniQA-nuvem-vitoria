    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "CPU do simulador — % de um núcleo",
      "description": "Counter process_cpu_seconds_total convertido em taxa por segundo; coleta padrão Linux.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mecaniqa-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "Sem dados / sem tráfego",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mecaniqa-prometheus"
          },
          "expr": "100 * rate(process_cpu_seconds_total{job=\"iot-simulator\"}[1m])",
          "legendFormat": "{{instance}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
